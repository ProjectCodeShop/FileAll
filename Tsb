                        local backOffset = (-target.CFrame.LookVector * 2.5) - Vector3.new(0, 3, 0)
                        underTargetCFrame = CFrame.new(predictedPos + backOffset, predictedPos)
                    elseif SELECTED_SUB_TRICK == 8 then
                        underTargetCFrame = CFrame.new(target.Position - Vector3.new(0, 3.5, 0), target.Position)

local function findGlobalTarget()
    local Character = LocalPlayer.Character
    if not Character or not Character:FindFirstChild("HumanoidRootPart") then return nil end
    local RootPart = Character.HumanoidRootPart
    local closest, lastDist = nil, 100 
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Humanoid") and obj.Parent ~= Character then
            local isPlayer = Players:GetPlayerFromCharacter(obj.Parent)
            local isDummy = not isPlayer
            local canTarget = (TARGET_MODE == 1) or (TARGET_MODE == 2 and isPlayer) or (TARGET_MODE == 3 and isDummy)
            if canTarget then
                local targetRoot = obj.Parent:FindFirstChild("HumanoidRootPart")
                if targetRoot then
                    local dist = (RootPart.Position - targetRoot.Position).Magnitude
                    if dist < lastDist then lastDist = dist closest = targetRoot end
                end
            end
        end
    end
    return closest
end

local ExecuteTechAction = function()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local RootPart = char.HumanoidRootPart
    local target = findGlobalTarget()

    if target and target.Parent then
        if TECH_SUB_ENABLED or true then
            task.spawn(function() 
                VirtualInput:SendKeyEvent(true, DASH_KEY, false, game)
                if MULTI_TAP_TECH then
                    task.wait(0.05)
                    VirtualInput:SendKeyEvent(false, DASH_KEY, false, game)
                    task.wait(0.05)
                    VirtualInput:SendKeyEvent(true, DASH_KEY, false, game)
                end
            end)
            
            local startTime = tick()
            local connection
            local trickAngle = 0
            
            connection = RunService.Heartbeat:Connect(function()
                local elapsed = tick() - startTime
                if target and target.Parent and elapsed < LOCK_DURATION then
                    local tVelocity = target.AssemblyLinearVelocity or Vector3.zero
                    local predictedPos = target.Position + (tVelocity * 0.05)
                    local underTargetCFrame
                    
                    if SELECTED_SUB_TRICK == 1 then
                        trickAngle = trickAngle + 0.5
                        local subOffset = Vector3.new(math.cos(trickAngle) * 1.5, -3.5, math.sin(trickAngle) * 1.5)
                        underTargetCFrame = CFrame.new(predictedPos + subOffset, predictedPos + target.CFrame.LookVector)
                    elseif SELECTED_SUB_TRICK == 2 then
                        local forwardOffset = target.CFrame.LookVector * 2.5
                        underTargetCFrame = CFrame.new(predictedPos + forwardOffset - Vector3.new(0, 3.2, 0), predictedPos)
                    elseif SELECTED_SUB_TRICK == 3 then
                        local bounceY = -3.5 + (math.sin(elapsed * 25) * 0.8)
                        underTargetCFrame = CFrame.new(predictedPos + Vector3.new(0, bounceY, 0), predictedPos + target.CFrame.LookVector)
                    elseif SELECTED_SUB_TRICK == 4 then
                        local sideOffset = target.CFrame.RightVector * (math.sin(elapsed * 18) * 3)
                        underTargetCFrame = CFrame.new(predictedPos + sideOffset - Vector3.new(0, 3, 0), predictedPos)
                    elseif SELECTED_SUB_TRICK == 5 then
                        local heightPhase = (math.cos(elapsed * 12) * 2.5) - 2.5
                        underTargetCFrame = CFrame.new(predictedPos + Vector3.new(0, heightPhase, 0), predictedPos)
                    elseif SELECTED_SUB_TRICK == 6 then
                        local angleOffset = (target.CFrame.RightVector * 2) - Vector3.new(0, 3.2, 0)

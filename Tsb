-- Dynamic Island Notification System
local function Notify(text)
    local msg = Instance.new("Frame", ScreenGui)
    msg.Size = UDim2.new(0, 180, 0, 32)
    msg.Position = UDim2.new(0.5, -90, 0, 10)
    msg.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    msg.BackgroundTransparency = 0.15
    msg.ClipsDescendants = true
    
    local corner = Instance.new("UICorner", msg)
    corner.CornerRadius = UDim.new(1, 0)
    
    local stroke = Instance.new("UIStroke", msg)
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.Transparency = 0.85
    stroke.Thickness = 1.2
    
    local txt = Instance.new("TextLabel", msg)
    txt.Size = UDim2.new(1, -20, 1, 0)
    txt.Position = UDim2.new(0, 10, 0, 0)
    txt.BackgroundTransparency = 1
    txt.Text = text
    txt.Font = Enum.Font.GothamBold
    txt.TextSize = 10
    txt.TextColor3 = Color3.fromRGB(255, 255, 255)

    msg.Size = UDim2.new(0, 80, 0, 24)
    msg.BackgroundTransparency = 0.5
    
    TweenService:Create(msg, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 210, 0, 34),
        BackgroundTransparency = 0.15
    }):Play()
    
    task.delay(2.0, function()
        local tween = TweenService:Create(msg, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 60, 0, 20),
            BackgroundTransparency = 1
        })
        tween:Play()
        tween.Completed:Connect(function()
            msg:Destroy()
        end)
    end)
end


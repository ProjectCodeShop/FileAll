-- Tab System
local Tabs = {}
local FirstTab = true

local function CreateTab(tabName, tabIconId)
    local TabButton = Instance.new("TextButton")
    TabButton.Name = tabName .. "TabBtn"
    TabButton.Size = UDim2.new(1, 0, 0, 34)
    TabButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    TabButton.BackgroundTransparency = 0.95
    TabButton.Text = ""
    TabButton.AutoButtonColor = false
    TabButton.Parent = TabButtonContainer
    Instance.new("UICorner", TabButton).CornerRadius = UDim.new(0, 12)

    local TabIcon = Instance.new("ImageLabel")
    TabIcon.Name = "TabIcon"
    TabIcon.Size = UDim2.new(0, 16, 0, 16)
    TabIcon.Position = UDim2.new(0, 12, 0.5, -8)
    TabIcon.BackgroundTransparency = 1
    TabIcon.Image = tabIconId or "rbxassetid://6031075931"
    TabIcon.ImageColor3 = Color3.fromRGB(170, 175, 195)
    TabIcon.Parent = TabButton

    local TabLabel = Instance.new("TextLabel")
    TabLabel.Name = "TabLabel"
    TabLabel.Size = UDim2.new(1, -38, 1, 0)
    TabLabel.Position = UDim2.new(0, 36, 0, 0)
    TabLabel.Text = tabName
    TabLabel.Font = Enum.Font.GothamMedium
    TabLabel.TextSize = 11
    TabLabel.TextColor3 = Color3.fromRGB(170, 175, 195)
    TabLabel.TextXAlignment = Enum.TextXAlignment.Left
    TabLabel.BackgroundTransparency = 1
    TabLabel.Parent = TabButton

    local ContentArea = Instance.new("ScrollingFrame")
    ContentArea.Name = tabName .. "Page"
    ContentArea.Size = UDim2.new(1, -160, 1, -28)
    ContentArea.Position = UDim2.new(0, 152, 0, 14)
    ContentArea.BackgroundTransparency = 1
    ContentArea.ScrollBarThickness = 0
    ContentArea.CanvasSize = UDim2.new(0, 0, 0, 0)
    ContentArea.AutomaticCanvasSize = Enum.AutomaticSize.Y
    ContentArea.Visible = false
    ContentArea.Parent = PagesFolder

    local ContentList = Instance.new("UIListLayout", ContentArea)
    ContentList.Padding = UDim.new(0, 8)
    ContentList.HorizontalAlignment = Enum.HorizontalAlignment.Center

    local function SelectTab()
        for _, tabData in pairs(Tabs) do
            tabData.Page.Visible = false
            TweenService:Create(tabData.Button, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {BackgroundTransparency = 0.95}):Play()
            TweenService:Create(tabData.Icon, TweenInfo.new(0.25), {ImageColor3 = Color3.fromRGB(170, 175, 195)}):Play()
            TweenService:Create(tabData.Label, TweenInfo.new(0.25), {TextColor3 = Color3.fromRGB(170, 175, 195)}):Play()
        end
        ContentArea.Visible = true
        TweenService:Create(TabButton, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {BackgroundTransparency = 0.8}):Play()
        TweenService:Create(TabIcon, TweenInfo.new(0.25), {ImageColor3 = Color3.fromRGB(255, 255, 255)}):Play()
        TweenService:Create(TabLabel, TweenInfo.new(0.25), {TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
    end

    TabButton.MouseButton1Click:Connect(SelectTab)

    table.insert(Tabs, {
        Button = TabButton,
        Icon = TabIcon,
        Label = TabLabel,
        Page = ContentArea
    })

    if FirstTab then
        FirstTab = false
        SelectTab()
    end

    return ContentArea
end

-- ==================== iOS CARD TOGGLE CREATOR ====================
local function CreateiOSToggle(parentPage, titleText, defaultState, callback)
    local Card = Instance.new("TextButton")
    Card.Name = titleText .. "Card"
    Card.Size = UDim2.new(0.96, 0, 0, 42)
    Card.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Card.BackgroundTransparency = 0.93
    Card.Text = ""
    Card.AutoButtonColor = false
    Card.Parent = parentPage
    Instance.new("UICorner", Card).CornerRadius = UDim.new(0, 14)

    local Stroke = Instance.new("UIStroke", Card)
    Stroke.Color = Color3.fromRGB(255, 255, 255)
    Stroke.Thickness = 1
    Stroke.Transparency = 0.88

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, -60, 1, 0)
    Label.Position = UDim2.new(0, 14, 0, 0)
    Label.Text = titleText
    Label.Font = Enum.Font.GothamMedium
    Label.TextSize = 11
    Label.TextColor3 = Color3.fromRGB(235, 235, 245)
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.BackgroundTransparency = 1
    Label.Parent = Card

    local TogglePill = Instance.new("Frame")
    TogglePill.Size = UDim2.new(0, 38, 0, 22)
    TogglePill.Position = UDim2.new(1, -50, 0.5, -11)
    TogglePill.BackgroundColor3 = defaultState and Color3.fromRGB(52, 199, 89) or Color3.fromRGB(120, 120, 130)
    TogglePill.BackgroundTransparency = defaultState and 0 or 0.5
    TogglePill.Parent = Card
    Instance.new("UICorner", TogglePill).CornerRadius = UDim.new(1, 0)

    local ToggleCircle = Instance.new("Frame")
    ToggleCircle.Size = UDim2.new(0, 18, 0, 18)
    ToggleCircle.Position = defaultState and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
    ToggleCircle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    ToggleCircle.Parent = TogglePill
    Instance.new("UICorner", ToggleCircle).CornerRadius = UDim.new(1, 0)

    local state = defaultState

    Card.MouseButton1Click:Connect(function()
        state = not state
        local targetCirclePos = state and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
        local targetPillColor = state and Color3.fromRGB(52, 199, 89) or Color3.fromRGB(120, 120, 130)
        local targetPillTrans = state and 0 or 0.5

        TweenService:Create(ToggleCircle, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = targetCirclePos}):Play()
        TweenService:Create(TogglePill, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {BackgroundColor3 = targetPillColor, BackgroundTransparency = targetPillTrans}):Play()

        callback(state, Card)
    end)

    return Card
end


-- ==================== KillAll (FreeFire BR: WeaponFired + WeaponHit) ====================
getgenv().ShootKA_Enabled = false

local Eventos = ReplicatedStorage:WaitForChild("Eventos")
local WeaponFired = Eventos:WaitForChild("WeaponFired")
local WeaponHit = Eventos:WaitForChild("WeaponHit")
local WeaponReloadRequest = Eventos:WaitForChild("WeaponReloadRequest")
local WS = require(ReplicatedStorage:WaitForChild("Shop"):WaitForChild("WeaponsSystem"))
local KA_DELAY = 0.15
local KA_MAXDIST = 900

_G.__SHOTBASE = nil
_G.__SHOTEXTRA = 0
local shotsSinceReload = 0

local function myWeapon()
    local w = WS.currentWeapon
    if w and w.instance and w.instance.Parent then return w end
    local ch = LocalPlayer.Character or Workspace:FindFirstChild(LocalPlayer.Name)
    local tool = ch and ch:FindFirstChildWhichIsA("Tool")
    if not tool then
        local bp = LocalPlayer:FindFirstChild("Backpack")
        tool = bp and bp:FindFirstChildWhichIsA("Tool")
    end
    if tool then
        local ok, w2 = pcall(WS.getWeaponForInstance, tool)
        if ok and w2 then return w2 end
    end
    return nil
end

local function myHeadPos()
    local ch = LocalPlayer.Character or Workspace:FindFirstChild(LocalPlayer.Name)
    local head = ch and ch:FindFirstChild("Head")
    if head then return head.Position end
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    if hrp then return hrp.Position + Vector3.new(0, 1.5, 0) end
    return nil
end

local function fireNearest()
    local ch0 = LocalPlayer.Character or Workspace:FindFirstChild(LocalPlayer.Name)
    local holding = ch0 and ch0:FindFirstChildWhichIsA("Tool") ~= nil
    local auto = getgenv().ShootKA_Enabled
    local heldMode = getgenv().ShootKA_HeldOnly
    if not (auto or (heldMode and holding)) then return end
    local w = myWeapon()
    if not w then return end
    local tool = w.instance
    local origin = myHeadPos()
    if not origin then return end
    local order = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local ch = p.Character or Workspace:FindFirstChild(p.Name)
            local head = ch and ch:FindFirstChild("Head")
            local hum = ch and ch:FindFirstChildOfClass("Humanoid")
            if head and hum and hum.Health > 0 then
                local d = (head.Position - origin).Magnitude
                if d < KA_MAXDIST then
                    table.insert(order, { head = head, hum = hum, d = d })
                end
            end
        end
    end
    if #order == 0 then return end
    table.sort(order, function(a, b) return a.d < b.d end)
    for _, tgt in ipairs(order) do
        if tgt.head.Parent and tgt.hum.Health > 0 then
            local base = (w and w.nextShotId) or 1
            if base ~= _G.__SHOTBASE then
                _G.__SHOTBASE = base
                _G.__SHOTEXTRA = 0
            end
            _G.__SHOTEXTRA += 1
            local id = base + _G.__SHOTEXTRA
            local hp = tgt.head.Position
            local dir = hp - origin
            local dist = dir.Magnitude
            if dist >= 0.001 then
                dir = dir.Unit
                WeaponFired:FireServer(tool, { origin = origin, dir = dir, charge = 0, id = id })
                task.wait(0.03)
                WeaponHit:FireServer(tool, {
                    part = tgt.head,
                    p = hp,
                    n = -dir,
                    m = tgt.head.Material,
                    d = dist,
                    t = 0.5,
                    h = tgt.hum,
                    sid = id,
                    pid = 1,
                    maxDist = dist,
                })
            end
        end
    end
    shotsSinceReload += #order
    local mag = (w.configValues and w.configValues.AmmoCapacity) or 7
    if shotsSinceReload >= mag - 1 then
        shotsSinceReload = 0
        pcall(function() WeaponReloadRequest:FireServer(tool) end)
        task.wait(0.5)
    end
end

local kaAcc = 0
local kaLast = os.clock()
local function kaStep()
    local now = os.clock()
    kaAcc += now - kaLast
    kaLast = now
    if kaAcc >= KA_DELAY then
        kaAcc = 0
        local ok, err = pcall(fireNearest)
        if not ok then warn("[KillAll] " .. tostring(err)) end
    end
end

RL = rawget(_G, "STATE")
if _G.__SHOOTKA_LOOP then
    pcall(function() _G.__SHOOTKA_LOOP:Disconnect() end)

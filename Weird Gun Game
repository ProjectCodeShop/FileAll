-- ==================== ELITE OPTIMIZED DRAWING ESP (FIXED SIZING) ====================
getgenv().ESP_PLAYERS = false
getgenv().ESP_BOTS = false

local ESPCache = {}

local function ClearESPDrawing(cache)
    if cache then
        for _, obj in pairs(cache) do
            pcall(function() obj:Remove() end)
        end
    end
end

local function CreateDrawingESP(targetModel, nameText, color)
    if not ESPCache[targetModel] then
        local box = Drawing.new("Square")
        box.Visible = false
        box.Thickness = 1.2
        box.Color = color
        box.Filled = false

        local line = Drawing.new("Line")
        line.Visible = false
        line.Thickness = 1
        line.Color = color

        local healthBarBg = Drawing.new("Square")
        healthBarBg.Visible = false
        healthBarBg.Thickness = 1
        healthBarBg.Color = Color3.fromRGB(20, 20, 20)
        healthBarBg.Filled = true

        local healthBar = Drawing.new("Square")
        healthBar.Visible = false
        healthBar.Thickness = 1
        healthBar.Color = Color3.fromRGB(52, 199, 89)
        healthBar.Filled = true

        local nameTag = Drawing.new("Text")
        nameTag.Visible = false
        nameTag.Size = 12
        nameTag.Center = true
        nameTag.Outline = true
        nameTag.Color = color
        nameTag.Font = Drawing.Fonts.Monospace

        ESPCache[targetModel] = {
            Box = box,
            Line = line,
            HealthBarBg = healthBarBg,
            HealthBar = healthBar,
            NameTag = nameTag
        }
    end

    local cache = ESPCache[targetModel]
    local rootPart = targetModel:FindFirstChild("HumanoidRootPart") or targetModel:FindFirstChild("Head") or targetModel:FindFirstChildWhichIsA("BasePart")
    local humanoid = targetModel:FindFirstChildOfClass("Humanoid")

    if rootPart and humanoid and humanoid.Health > 0 then
        local cf, size = targetModel:GetBoundingBox()
        local topPosition = (cf + Vector3.new(0, size.Y / 2, 0)).Position
        local bottomPosition = (cf - Vector3.new(0, size.Y / 2, 0)).Position
        
        local topVector, topOnScreen = Camera:WorldToViewportPoint(topPosition)
        local bottomVector, bottomOnScreen = Camera:WorldToViewportPoint(bottomPosition)
        local rootVector, onScreen = Camera:WorldToViewportPoint(rootPart.Position)

        if onScreen or topOnScreen or bottomOnScreen then
            local dist = math.floor((rootPart.Position - Camera.CFrame.Position).Magnitude)
            
            local h = math.abs(bottomVector.Y - topVector.Y)
            if h < 10 then h = 10 end
            local w = h * 0.65
            local x = rootVector.X - w / 2
            local y = topVector.Y

            -- 1) ESP Line
            cache.Line.Visible = true
            cache.Line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
            cache.Line.To = Vector2.new(rootVector.X, bottomVector.Y)
            cache.Line.Color = color

            -- 2) Box ESP
            cache.Box.Visible = true
            cache.Box.Size = Vector2.new(w, h)
            cache.Box.Position = Vector2.new(x, y)

            -- 3) Health Bar Background
            cache.HealthBarBg.Visible = true
            cache.HealthBarBg.Size = Vector2.new(3, h)
            cache.HealthBarBg.Position = Vector2.new(x - 5, y)

            -- 4) Health Bar Fill
            local hpPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
            local hpHeight = h * hpPercent
            cache.HealthBar.Visible = true
            cache.HealthBar.Size = Vector2.new(3, hpHeight)
            cache.HealthBar.Position = Vector2.new(x - 5, y + (h - hpHeight))
            
            if hpPercent > 0.6 then
                cache.HealthBar.Color = Color3.fromRGB(52, 199, 89)
            elseif hpPercent > 0.3 then
                cache.HealthBar.Color = Color3.fromRGB(255, 204, 0)
            else
                cache.HealthBar.Color = Color3.fromRGB(255, 59, 48)
            end

            -- 5) Name & Distance Tag
            cache.NameTag.Visible = true
            cache.NameTag.Text = nameText .. " [" .. dist .. "m]"
            cache.NameTag.Position = Vector2.new(rootVector.X, y - 16)
            return
        end
    end

    cache.Box.Visible = false
    cache.Line.Visible = false
    cache.HealthBarBg.Visible = false
    cache.HealthBar.Visible = false
    cache.NameTag.Visible = false
end

RunService.RenderStepped:Connect(function()
    for model, cache in pairs(ESPCache) do
        if not model or not model.Parent or (model:FindFirstChildOfClass("Humanoid") and model:FindFirstChildOfClass("Humanoid").Health <= 0) then
            ClearESPDrawing(cache)
            ESPCache[model] = nil
        end
    end

    if getgenv().ESP_PLAYERS then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                CreateDrawingESP(p.Character, p.Name, Color3.fromRGB(0, 255, 128))
            end
        end
    end

    if getgenv().ESP_BOTS then
        local sb = Workspace:FindFirstChild("ServerBots") or Workspace:FindFirstChild("ServerBots", true)
        if sb then
            for _, b in ipairs(sb:GetChildren()) do
                CreateDrawingESP(b, "[Bot] " .. b.Name, Color3.fromRGB(255, 80, 80))
            end
        end
    end
end)

CreateToggle(ESPTab, "Player ESP", false, function(s) 
    getgenv().ESP_PLAYERS = s 
    if not s then
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character and ESPCache[p.Character] then
                ClearESPDrawing(ESPCache[p.Character])
                ESPCache[p.Character] = nil
            end
        end
    end
end)

CreateToggle(ESPTab, "Bot ESP", false, function(s) 
    getgenv().ESP_BOTS = s 
    if not s then
        local sb = Workspace:FindFirstChild("ServerBots") or Workspace:FindFirstChild("ServerBots", true)
        if sb then
            for _, b in ipairs(sb:GetChildren()) do
                if ESPCache[b] then
                    ClearESPDrawing(ESPCache[b])
                    ESPCache[b] = nil
                end
            end
        end
    end
end)


local function CurrentGuns()
    local list = {}
    local char = LocalPlayer.Character
    if char then
        for _, d in ipairs(char:GetChildren()) do
            if d:IsA("Tool") then table.insert(list, d) end
        end
    end
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then table.insert(list, item) end
        end
    end
    return list
end

local function FireAt(gun, cf, humanoid, isPlayer, dist)
    if not gun or not gun.Parent then return end
    if not humanoid or not humanoid.Parent or humanoid.Health <= 0 then return end
    
    local ev = ReplicatedStorage:FindFirstChild("Events")
    local shoot = ev and ev:FindFirstChild("Shoot")
    if not shoot then return end
    
    local inner = isPlayer and { humanoid, true, true, dist } or { humanoid, false, true, dist }
    local args = {
        [1] = Workspace:GetServerTimeNow(),
        [2] = gun,
        [3] = cf,
        [4] = true,
        [5] = { ["1"] = inner },
        n = 5,
    }
    pcall(function() 
        shoot:FireServer(unpack(args, 1, args.n or #args)) 
    end)
end

if getgenv().__MA_CONNS then
    for _, c in ipairs(getgenv().__MA_CONNS) do pcall(function() c:Disconnect() end) end

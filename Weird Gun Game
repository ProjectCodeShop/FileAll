-- 1) Kill Aura
table.insert(getgenv().__MA_CONNS, RunService.RenderStepped:Connect(function()
    if not getgenv().KILL_AURA then return end
    local guns, cam = gunsAndCam()
    if #guns > 0 and cam then
        local myPos = getMyRootPosition()
        local gi = 0

        for _, obj in ipairs(Workspace:GetDescendants()) do
            if not getgenv().KILL_AURA then break end
            if obj:IsA("Humanoid") and obj.Health > 0 then
                local character = obj.Parent
                if character and character ~= LocalPlayer.Character then
                    local charName = character.Name:lower()
                    local parentName = character.Parent and character.Parent.Name:lower() or ""
                    
                    local isTargetOrDummy = charName:find("target") or charName:find("dummy") or parentName:find("target") or parentName:find("targets") or parentName:find("dummies")
                    
                    if not isTargetOrDummy then
                        local isPlayerChar = Players:GetPlayerFromCharacter(character) ~= nil
                        local isBotChar = charName:find("bot") or parentName:find("serverbots") or parentName:find("bot")

                        if isPlayerChar or isBotChar then
                            local rootPart = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head") or character:FindFirstChildWhichIsA("BasePart")
                            if rootPart then
                                local dist = (rootPart.Position - myPos).Magnitude
                                if dist <= 200 then
                                    gi = gi + 1
                                    if gi > #guns then gi = 1 end
                                    local g = guns[gi]
                                    if g and g.Parent then
                                        local targetPos = rootPart.Position
                                        local realDist = math.clamp(math.floor((targetPos - cam.CFrame.Position).Magnitude), 1, 500)
                                        FireAt(g, CFrame.lookAt(cam.CFrame.Position, targetPos), obj, true, realDist)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end))


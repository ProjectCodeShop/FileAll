-- Toggle Open/Close Animation
local function ToggleHub()
    isOpen = not isOpen
    UpdateBlurState()
    if isOpen then
        MainFrame.Visible = true
        MainFrame.Size = UDim2.new(0, SidebarWidth, 0, 330)
        TweenService:Create(MainFrame, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, FullWidth, 0, 330)}):Play()
    else
        local tween = TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(0, 0, 0, 330)})
        tween:Play()
        tween.Completed:Connect(function()
            if not isOpen then
                MainFrame.Visible = false
            end
        end)
    end
end


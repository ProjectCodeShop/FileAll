CreateToggle(PlayerTab, "HitboxMod", false, function(state)
    if state then
        pcall(function()
            local mt = getrawmetatable(game)
            setreadonly(mt, false)
            local old = mt.__namecall
            mt.__namecall = newcclosure(function(self, ...)
                local args = {...}
                if getnamecallmethod() == "FireServer" and tostring(self) == "Action" then
                    args[2] = "hit"
                end
                return old(self, unpack(args))
            end)
        end)
    end
end)

CreateToggle(PlayerTab, "BaconMode (Auto Farm)", false, function(state)
    if state then
        task.spawn(function()
            while state do
                local mobs = Workspace:FindFirstChild("Mobs") or Workspace:FindFirstChild("Enemies")
                if mobs then
                    for _, mob in pairs(mobs:GetChildren()) do
                        if mob:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                            LocalPlayer.Character.HumanoidRootPart.CFrame = mob.HumanoidRootPart.CFrame * CFrame.new(0, 5, 0)
                            task.wait(0.01)
                        end
                    end
                end
                task.wait(0.1)
            end
        end)
    end
end)

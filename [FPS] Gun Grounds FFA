CreateToggle(VisualTab, "ESP Tracers", false, function(state)
    _G.ESPTracer = state
    local tracers = {}
    RunService.RenderStepped:Connect(function()
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                if not tracers[p] then
                    local line = Drawing.new("Line")
                    line.Visible = false
                    line.Thickness = 1.5
                    tracers[p] = line
                end
                local line = tracers[p]
                if _G.ESPTracer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                    local hrp = p.Character.HumanoidRootPart
                    local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        line.To = Vector2.new(vector.X, vector.Y)
                        line.Color = _G.EspColor
                        line.Visible = true
                    else
                        line.Visible = false
                    end
                else
                    line.Visible = false
                end
            end
        end
    end)
end)

-- Health & Damage Notification Tracking System
local trackedHealths = {}
local recentDamagers = {}

RunService.RenderStepped:Connect(function()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Humanoid") then
            local humanoid = p.Character.Humanoid
            if not trackedHealths[p] then
                trackedHealths[p] = humanoid.Health
                humanoid.HealthChanged:Connect(function(newHealth)
                    local oldHealth = trackedHealths[p] or newHealth
                    if newHealth < oldHealth then
                        -- Player took damage, check if local player caused damage or if they died
                        recentDamagers[p] = LocalPlayer
                    end
                    if newHealth <= 0 and oldHealth > 0 then
                        if recentDamagers[p] == LocalPlayer then
                            SendIOSNotification("Elimination", "Successfully eliminated: " .. p.Name)
                            recentDamagers[p] = nil
                        end
                    end
                    trackedHealths[p] = newHealth
                end)
            end
        end
    end
end)

CreateToggle(VisualTab, "ESP Health Bar", false, function(state)
    _G.ESPHealth = state
    RunService.RenderStepped:Connect(function()
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid") then
                local head = p.Character.Head
                local humanoid = p.Character.Humanoid
                local gui = head:FindFirstChild("HealthTagGui")
                if _G.ESPHealth and humanoid.Health > 0 then
                    if not gui then
                        gui = Instance.new("BillboardGui")
                        gui.Name = "HealthTagGui"
                        gui.Size = UDim2.new(0, 100, 0, 40)
                        gui.StudsOffset = Vector3.new(0, 2.5, 0)
                        gui.AlwaysOnTop = true
                        gui.Parent = head

                        local lbl = Instance.new("TextLabel")
                        lbl.Name = "HealthLabel"
                        lbl.Size = UDim2.new(1, 0, 1, 0)
                        lbl.BackgroundTransparency = 1
                        lbl.Font = Enum.Font.GothamBold
                        lbl.TextSize = 11
                        lbl.TextColor3 = Color3.fromRGB(52, 199, 123)
                        lbl.TextStrokeTransparency = 0.5
                        lbl.Parent = gui
                    end
                    local lbl = gui:FindFirstChild("HealthLabel")
                    if lbl then
                        lbl.Text = p.Name .. "\nHP: " .. math.floor(humanoid.Health) .. "/" .. math.floor(humanoid.MaxHealth)
                    end
                else
                    if gui then gui:Destroy() end
                end
            end
        end
    end)
end)


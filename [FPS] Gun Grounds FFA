CreateToggle(CombatTab, "Aimbot Lock", false, function(state)
    _G.Silent = state
    RunService.RenderStepped:Connect(function()
        if _G.Silent then
            local target = nil
            local dist = math.huge
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild(_G.AimPart) and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                    local d = (p.Character[_G.AimPart].Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
                    if d < dist then target = p.Character[_G.AimPart] dist = d end
                end
            end
            if target then 
                Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, target.Position), 0.5) 
            end
        end
    end)
end)

CreateSlider(CombatTab, "Aimbot Smoothness", 1, 10, 5, function(val)
    _G.AimbotSmooth = val
end)

CreateToggle(CombatTab, "Wallbang", false, function(state)
    _G.Wallbang = state
    RunService.Stepped:Connect(function()
        if _G.Wallbang then

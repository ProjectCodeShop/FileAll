        ContentArea.Visible = true
        TweenService:Create(TabButton, SpringAnim.Bounce, {BackgroundTransparency = 0.78, Size = UDim2.new(1, -4, 0, 34)}):Play()
        TweenService:Create(TabIcon, SpringAnim.Bounce, {ImageColor3 = Color3.fromRGB(255, 255, 255)}):Play()
        TweenService:Create(TabLabel, SpringAnim.Bounce, {TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
    end

    TabButton.MouseButton1Click:Connect(SelectTab)

    table.insert(Tabs, { Button = TabButton, Icon = TabIcon, Label = TabLabel, Page = ContentArea })

    if FirstTab then

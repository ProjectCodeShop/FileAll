        for _, tabData in pairs(Tabs) do
            tabData.Page.Visible = false
            TweenService:Create(tabData.Button, SpringAnim.Soft, {BackgroundTransparency = 0.95, Size = UDim2.new(1, 0, 0, 34)}):Play()

local function ToggleHub()
    isOpen = not isOpen
    UpdateBlurState()
    if isOpen then
        MainFrame.Visible = true
        MainFrame.Size = UDim2.new(0, SidebarWidth, 0, 310)
        TweenService:Create(MainFrame, SpringAnim.Open, {Size = UDim2.new(0, FullWidth, 0, 310)}):Play()
    else

    local MessageLabel = Instance.new("TextLabel")
    MessageLabel.Name = "Message"
    MessageLabel.Parent = ContentHolder
    MessageLabel.BackgroundTransparency = 1
    MessageLabel.Position = UDim2.new(0, 14, 0, 56)
    MessageLabel.Size = UDim2.new(1, -28, 0, 22)
    MessageLabel.Font = Enum.Font.Gotham
    MessageLabel.Text = message or ""
    MessageLabel.TextColor3 = Color3.fromRGB(210, 215, 230)
    MessageLabel.TextSize = 11
    MessageLabel.TextXAlignment = Enum.TextXAlignment.Left
    MessageLabel.TextWrapped = true
    MessageLabel.TextTransparency = 1

    local targetHeight = 88

    -- Open Animation
    TweenService:Create(Toast, SpringAnim.Open, {Size = UDim2.new(1, 0, 0, targetHeight), BackgroundTransparency = 0.22}):Play()
    TweenService:Create(UIStroke, SpringAnim.Open, {Transparency = 0.85}):Play()
    TweenService:Create(AppIcon, SpringAnim.Soft, {ImageTransparency = 0}):Play()
    TweenService:Create(AppHeader, SpringAnim.Soft, {TextTransparency = 0}):Play()
    TweenService:Create(TimeLabel, SpringAnim.Soft, {TextTransparency = 0}):Play()
    TweenService:Create(TitleLabel, SpringAnim.Soft, {TextTransparency = 0}):Play()
    TweenService:Create(MessageLabel, SpringAnim.Soft, {TextTransparency = 0}):Play()

    -- Dismiss Logic Function
    local isClosing = false
    local function DismissNotification()
        if isClosing then return end
        isClosing = true

        local dismiss = TweenService:Create(Toast, SpringAnim.Close, {Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1})
        TweenService:Create(TitleLabel, SpringAnim.Close, {TextTransparency = 1}):Play()
        TweenService:Create(MessageLabel, SpringAnim.Close, {TextTransparency = 1}):Play()
        TweenService:Create(AppHeader, SpringAnim.Close, {TextTransparency = 1}):Play()
        TweenService:Create(TimeLabel, SpringAnim.Close, {TextTransparency = 1}):Play()
        TweenService:Create(AppIcon, SpringAnim.Close, {ImageTransparency = 1}):Play()
        TweenService:Create(UIStroke, SpringAnim.Close, {Transparency = 1}):Play()
        
        dismiss:Play()
        dismiss.Completed:Connect(function()
            Toast:Destroy()
        end)
    end

    -- Swipe Up Event
    local touchStart, isSwiping = nil, false
    Toast.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            touchStart = input.Position
            isSwiping = true
        end
    end)

    Toast.InputEnded:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and isSwiping then
            isSwiping = false
            if touchStart and (touchStart.Y - input.Position.Y) > 15 then
                DismissNotification()
            end
        end
    end)

    -- Auto Dismiss Timer
    task.delay(duration, function()
        if Toast and Toast.Parent then
            DismissNotification()
        end
    end)
end


local function scanSmartAIWall(hrp, character)
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {character, targetMarker}
    rayParams.FilterType = Enum.RaycastFilterType.Exclude

    local angles = {0, 30, -30, 60, -60, 90, -90, 120, -120, 180}
    for _, angle in ipairs(angles) do
        local rotatedLook = (CFrame.Angles(0, math.rad(angle), 0) * hrp.CFrame.LookVector).Unit
        local result = workspace:Raycast(hrp.Position, rotatedLook * 4.5, rayParams)
        if result and result.Instance and result.Instance.CanCollide then
            return result
        end
    end
    return nil
end

-- 1. Fake Wall Hop (ปิด AutoRotate แล้วสะบัดตัวละครหันซ้าย-ขวา/หันหลังกลับแบบฉับพลัน พร้อมพุ่งตัว)
UserInputService.JumpRequest:Connect(function()
    local character = player.Character
    if not character or not character:FindFirstChild("Humanoid") or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local humanoid = character.Humanoid
    local hrp = character.HumanoidRootPart

    if fakeActive and not autoPathActive then
        local wallHit = scanSmartAIWall(hrp, character)
        
        if wallHit then
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            humanoid.Jump = true

            -- ปิดการหมุนตัวออโต้ของเกมชั่วคราว เพื่อให้เราบังคับทิศทางตัวละครเองได้เต็มที่
            humanoid.AutoRotate = false

            turnToggle = (turnToggle + 1) % 4
            -- มุมสะบัดตัวละคร: หันขวา 90°, หันซ้าย -90°, หันหลังกลับ 180°
            local snapAngles = {90, -90, 180, -90}
            local snapAngle = snapAngles[turnToggle + 1]

            -- หมุนตัวละคร (ตัวละครจะสะบัดหันข้าง/หันหลังจริงทันทีโดยกล้องไม่ขยับตาม)
            hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(snapAngle), 0)
            
            -- อัดแรงพุ่งตัวและดีดตัวขึ้นฟ้า
            local lookDir = hrp.CFrame.LookVector
            hrp.AssemblyLinearVelocity = Vector3.new(lookDir.X * 22, 38, lookDir.Z * 22)

            -- เปิด AutoRotate กลับมาเหมือนเดิมหลังจากสะบัดเสร็จ 0.15 วิ
            task.delay(0.15, function()
                if humanoid then
                    humanoid.AutoRotate = true
                end
            end)
        end
    end
end)

-- 2. AI Smart Auto Wall Hop Target (ออโต้สะบัดตัวละครหันข้าง/หันหลังไต่กำแพงรัวๆ)
RunService.Stepped:Connect(function()
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") or not character:FindFirstChild("Humanoid") then return end
    
    local hrp = character.HumanoidRootPart
    local humanoid = character.Humanoid
    local now = tick()

    if autoPathActive and targetPosition then
        local horizontalDist = (Vector3.new(targetPosition.X, 0, targetPosition.Z) - Vector3.new(hrp.Position.X, 0, hrp.Position.Z)).Magnitude
        local heightDiff = math.abs(targetPosition.Y - hrp.Position.Y)

        if horizontalDist < 3.5 and heightDiff < 5.0 then
            autoPathActive = false
            if targetMarker then targetMarker:Destroy() targetMarker = nil end
            targetPosition = nil
            setSwitchState(autoPathSwitch, autoPathKnob, false)
            humanoid:Move(Vector3.new(0, 0, 0))
            return
        end

        local wallHit = scanSmartAIWall(hrp, character)
        local direction = (targetPosition - hrp.Position).Unit

        if wallHit then
            if now - lastHopTime >= 0.07 then
                lastHopTime = now

                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                humanoid.Jump = true
                humanoid.AutoRotate = false

                turnToggle = (turnToggle + 1) % 4
                local snapAngles = {90, -90, 180, -90}
                local snapAngle = snapAngles[turnToggle + 1]

                -- สะบัดตัวละครหันซ้ายขวา/หันหลังไต่กำแพง
                hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + direction) * CFrame.Angles(0, math.rad(snapAngle), 0)
                hrp.AssemblyLinearVelocity = Vector3.new(direction.X * 25, 40, direction.Z * 25)

                task.delay(0.12, function()
                    if humanoid then
                        humanoid.AutoRotate = true
                    end
                end)
            end
        else
            humanoid:MoveTo(targetPosition)
        end
    end
end)

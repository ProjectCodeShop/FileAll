-- ฟังก์ชันเปิด-ปิด UI หลัก
local uiVisible = true
local isDraggingToggle = false

toggleButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDraggingToggle = false
    end
end)

toggleButton.Changed:Connect(function(property)
    if property == "Position" then
        isDraggingToggle = true
    end
end)

toggleButton.MouseButton1Click:Connect(function()
    if isDraggingToggle then return end
    uiVisible = not uiVisible
    local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    if uiVisible then
        mainFrame.Visible = true
        TweenService:Create(mainFrame, tweenInfo, {Size = UDim2.new(0, 210, 0, 295), BackgroundTransparency = 0.12}):Play()
    else
        local hideTween = TweenService:Create(mainFrame, tweenInfo, {Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1})
        hideTween:Play()
        hideTween.Completed:Connect(function()
            if not uiVisible then mainFrame.Visible = false end
        end)
    end
end)

-- อนิเมชั่นสวิตช์แบบสมูท
local function setSwitchState(switchBG, knob, state)
    local tweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    if state then
        TweenService:Create(switchBG, tweenInfo, {BackgroundColor3 = Color3.fromRGB(52, 199, 89)}):Play()
        TweenService:Create(knob, tweenInfo, {Position = UDim2.new(1, -20, 0.5, -9)}):Play()
    else
        TweenService:Create(switchBG, tweenInfo, {BackgroundColor3 = Color3.fromRGB(50, 50, 56)}):Play()
        TweenService:Create(knob, tweenInfo, {Position = UDim2.new(0, 2, 0.5, -9)}):Play()
    end
end


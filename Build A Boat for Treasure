-- Noclip System
local function toggleNoclip(state)
	if state then
		if not noclipConnection then
			noclipConnection = RunService.Stepped:Connect(function()
				local char = LocalPlayer.Character
				if char then
					for _, part in ipairs(char:GetDescendants()) do
						if part:IsA("BasePart") then
							part.CanCollide = false
						end
					end
				end
			end)
		end
	else
		if noclipConnection then
			noclipConnection:Disconnect()
			noclipConnection = nil
		end
	end
end

-- Fire All Team Launch Remotes
local function fireAllLaunchEvents()
	for _, zoneName in ipairs(ZoneColors) do
		pcall(function()
			local zone = Workspace:FindFirstChild(zoneName)
			if zone then
				local remote = zone:FindFirstChild("VoteLaunchRE")
				if remote then
					remote:FireServer(table.unpack({n = 0}, 1, 0))
				end
			end
		end)
	end
end

-- Precise Flight System
local function flyToTarget(targetPos, extraHeight, activeCheck)
	extraHeight = extraHeight or 5
	local char = LocalPlayer.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local hrp = char.HumanoidRootPart
	local humanoid = char:FindFirstChild("Humanoid")
	
	if humanoid then
		humanoid.PlatformStand = true
	end

	local startPos = hrp.Position
	local finalTarget = Vector3.new(targetPos.X, targetPos.Y + extraHeight, targetPos.Z)
	local distance = (finalTarget - startPos).Magnitude
	
	local speed = 380
	local duration = math.clamp(distance / speed, 0.1, 5) 
	local elapsed = 0

	while activeCheck() and char and hrp and char.Parent and elapsed < duration do
		local dt = RunService.RenderStepped:Wait()
		elapsed = elapsed + dt
		local alpha = math.clamp(elapsed / duration, 0, 1)
		
		hrp.CFrame = CFrame.new(startPos:Lerp(finalTarget, alpha), finalTarget)
		hrp.Velocity = Vector3.new(0, 0, 0)
	end
	
	if char and hrp then
		hrp.CFrame = CFrame.new(finalTarget)
		hrp.Velocity = Vector3.new(0, 0, 0)
	end

	if humanoid then
		humanoid.PlatformStand = false
	end
end


FloatStroke.Thickness = 1.5
FloatStroke.Transparency = 0.5

local floatDragging = false
local floatDragInput, floatDragStart, floatStartPos
local floatMoved = false

FloatBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        floatDragging = true
        floatMoved = false
        floatDragStart = input.Position
        floatStartPos = FloatBtn.Position
        floatDragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if floatDragging and (input == floatDragInput or input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - floatDragStart
        if delta.Magnitude > 6 then 
            floatMoved = true 
            FloatBtn.Position = UDim2.new(
                floatStartPos.X.Scale, floatStartPos.X.Offset + delta.X,
                floatStartPos.Y.Scale, floatStartPos.Y.Offset + delta.Y
            )
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input == floatDragInput or input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        floatDragging = false
    end
end)

FloatBtn.MouseButton1Click:Connect(function()
    if not floatMoved then
        TweenService:Create(FloatBtn, TweenInfo.new(0.1), {Size = UDim2.new(0, 46, 0, 46)}):Play()
        task.delay(0.1, function()
            TweenService:Create(FloatBtn, TweenInfo.new(0.1), {Size = UDim2.new(0, 52, 0, 52)}):Play()
        end)
        ToggleHub()
    end
end)

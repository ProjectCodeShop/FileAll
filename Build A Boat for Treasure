-- Main Loop: Launch -> Fly 3 Rounds -> Reset -> Loop
task.spawn(function()
	while true do
		if autoFarmLoop then
			pcall(function()
				local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
				local humanoid = char:WaitForChild("Humanoid", 6)
				if not humanoid then return end
				
				task.wait(0.3)

				fireAllLaunchEvents()
				task.wait(0.3)

				for round = 1, 3 do
					if not autoFarmLoop then break end

					flyToTarget(pos1, 5, function() return autoFarmLoop end)
					task.wait(0.05)
					flyToTarget(pos2, 5, function() return autoFarmLoop end)
					task.wait(0.05)
					flyToTarget(pos3, 5, function() return autoFarmLoop end)
					task.wait(0.1)

					flyToTarget(pos2, 5, function() return autoFarmLoop end)
					task.wait(0.05)
					flyToTarget(pos1, 5, function() return autoFarmLoop end)
					task.wait(0.1)
				end

				if autoFarmLoop and char and char:FindFirstChild("Humanoid") then
					char.Humanoid.Health = 0
				end

				local timeout = tick() + 6
				repeat
					task.wait(0.2)
				until (LocalPlayer.Character and LocalPlayer.Character ~= char and LocalPlayer.Character:FindFirstChild("Humanoid") and LocalPlayer.Character.Humanoid.Health > 0) or tick() > timeout
				
				task.wait(0.3)
			end)
		else
			task.wait(0.3)
		end
	end
end)


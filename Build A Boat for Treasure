    TabLabel.TextSize = 11
    TabLabel.TextColor3 = Color3.fromRGB(160, 160, 185)
    TabLabel.TextXAlignment = Enum.TextXAlignment.Left
    TabLabel.BackgroundTransparency = 1
    TabLabel.ZIndex = 5
    TabLabel.Parent = TabButton

    local ContentArea = Instance.new("ScrollingFrame")
    ContentArea.Name = tabName .. "Page"
    ContentArea.Size = UDim2.new(1, -145, 1, -90)
    ContentArea.Position = UDim2.new(0, 135, 0, 85)
    ContentArea.BackgroundTransparency = 1
    ContentArea.ScrollBarThickness = 2
    ContentArea.Visible = false
    ContentArea.ZIndex = 4
    ContentArea.Parent = PagesFolder

    local ContentList = Instance.new("UIListLayout", ContentArea)
    ContentList.Padding = UDim.new(0, 8)
    ContentList.HorizontalAlignment = Enum.HorizontalAlignment.Center

    local function SelectTab()
        for _, tabData in pairs(Tabs) do
            tabData.Page.Visible = false
            TweenService:Create(tabData.Button, TweenInfo.new(0.25), {BackgroundTransparency = 1}):Play()
            TweenService:Create(tabData.Icon, TweenInfo.new(0.25), {ImageColor3 = Color3.fromRGB(160, 160, 185)}):Play()
            TweenService:Create(tabData.Label, TweenInfo.new(0.25), {TextColor3 = Color3.fromRGB(160, 160, 185)}):Play()
        end
        ContentArea.Visible = true
        ContentArea.Position = UDim2.new(0, 145, 0, 85)
        TweenService:Create(ContentArea, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = UDim2.new(0, 135, 0, 85)}):Play()
        
        TweenService:Create(TabButton, TweenInfo.new(0.25), {BackgroundTransparency = 0.82}):Play()
        TweenService:Create(TabIcon, TweenInfo.new(0.25), {ImageColor3 = Color3.fromRGB(255, 255, 255)}):Play()
        TweenService:Create(TabLabel, TweenInfo.new(0.25), {TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
    end

    TabButton.MouseButton1Click:Connect(SelectTab)
    table.insert(Tabs, {Button = TabButton, Icon = TabIcon, Label = TabLabel, Page = ContentArea})

    if FirstTab then
        FirstTab = false
        SelectTab()
    end

    return ContentArea
end


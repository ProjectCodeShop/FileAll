-- [ระบบอนิเมชันเปิด-ปิด ย่อ-ขยาย]
local uiVisible = true
local isAnimating = false
local defaultSize = UDim2.new(0, 520, 0, 310)
local defaultPos = UDim2.new(0.5, -260, 0.5, -155)

OpenButton.MouseButton1Click:Connect(function()
    if isAnimating then return end
    isAnimating = true
    uiVisible = not uiVisible

    -- อนิเมชันปุ่มตอนกด
    OpenButton:TweenSize(UDim2.new(0, 38, 0, 38), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.08, true, function()
        OpenButton:TweenSize(UDim2.new(0, 45, 0, 45), Enum.EasingDirection.Out, Enum.EasingStyle.Back, 0.12, true)
    end)

    if uiVisible then
        MainFrame.Visible = true
        MainFrame.Size = UDim2.new(0, 0, 0, 0)
        MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
        
        local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        local tween = TweenService:Create(MainFrame, tweenInfo, {
            Size = defaultSize,
            Position = defaultPos
        })
        tween:Play()
        tween.Completed:Connect(function()
            isAnimating = false
        end)
    else
        local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        local tween = TweenService:Create(MainFrame, tweenInfo, {
            Size = UDim2.new(0, 0, 0, 0),
            Position = UDim2.new(0.5, 0, 0.5, 0)
        })
        tween:Play()
        tween.Completed:Connect(function()
            MainFrame.Visible = false
            MainFrame.Size = defaultSize
            MainFrame.Position = defaultPos
            isAnimating = false
        end)
    end
end)


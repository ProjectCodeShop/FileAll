-- ฟังก์ชันสร้าง Toggle
local function addToggle(box, text, yPos, callback)
    local Row = Instance.new("TextButton")
    Row.Parent = box
    Row.BackgroundTransparency = 1
    Row.Position = UDim2.new(0, 8, 0, yPos)
    Row.Size = UDim2.new(0, box.AbsoluteSize.X - 16, 0, 18)
    Row.Font = Enum.Font.Gotham
    Row.Text = text
    Row.TextColor3 = Color3.fromRGB(160, 160, 170)
    Row.TextSize = 9
    Row.TextXAlignment = Enum.TextXAlignment.Left
    
    local chk = Instance.new("Frame")
    chk.Parent = Row
    chk.BackgroundColor3 = Color3.fromRGB(28, 28, 35)
    chk.Position = UDim2.new(1, -12, 0, 2)
    chk.Size = UDim2.new(0, 10, 0, 10)
    local chc = Instance.new("UICorner")
    chc.CornerRadius = UDim.new(0, 2)
    chc.Parent = chk
    
    local enabled = false
    Row.MouseButton1Click:Connect(function()
        enabled = not enabled
        chk.BackgroundColor3 = enabled and Color3.fromRGB(110, 90, 240) or Color3.fromRGB(28, 28, 35)
        if callback then callback(enabled) end
    end)
end

-- ฟังก์ชันสร้าง Slider
local function addSlider(box, text, yPos, min, max, default, callback)
    local Row = Instance.new("Frame")
    Row.Parent = box
    Row.BackgroundTransparency = 1
    Row.Position = UDim2.new(0, 8, 0, yPos)
    Row.Size = UDim2.new(0, box.AbsoluteSize.X - 16, 0, 32)
    
    local Label = Instance.new("TextLabel")
    Label.Parent = Row
    Label.BackgroundTransparency = 1
    Label.Position = UDim2.new(0, 0, 0, 0)
    Label.Size = UDim2.new(0, box.AbsoluteSize.X - 16, 0, 14)
    Label.Font = Enum.Font.Gotham
    Label.Text = text .. ": " .. tostring(default)
    Label.TextColor3 = Color3.fromRGB(160, 160, 170)
    Label.TextSize = 9
    Label.TextXAlignment = Enum.TextXAlignment.Left
    
    local SliderBg = Instance.new("Frame")
    SliderBg.Parent = Row
    SliderBg.BackgroundColor3 = Color3.fromRGB(25, 25, 32)
    SliderBg.Position = UDim2.new(0, 0, 0, 16)
    SliderBg.Size = UDim2.new(0, box.AbsoluteSize.X - 16, 0, 8)
    
    local sbc = Instance.new("UICorner")
    sbc.CornerRadius = UDim.new(0, 4)
    sbc.Parent = SliderBg
    
    local SliderFill = Instance.new("Frame")
    SliderFill.Parent = SliderBg
    SliderFill.BackgroundColor3 = Color3.fromRGB(110, 90, 240)
    SliderFill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    
    local sfc = Instance.new("UICorner")
    sfc.CornerRadius = UDim.new(0, 4)
    sfc.Parent = SliderFill
    
    local dragging = false
    local function updateSlider(input)
        local sizeX = SliderBg.AbsoluteSize.X
        local pos = math.clamp((input.Position.X - SliderBg.AbsolutePosition.X) / sizeX, 0, 1)
        SliderFill.Size = UDim2.new(pos, 0, 1, 0)
        local val = math.floor(min + (max - min) * pos)
        Label.Text = text .. ": " .. tostring(val)
        if callback then callback(val) end
    end
    
    SliderBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateSlider(input)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateSlider(input)
        end
    end)
end


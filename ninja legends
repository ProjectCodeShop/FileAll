                                    end

                                    if targetPart and char:FindFirstChild("HumanoidRootPart") then
                                        char.HumanoidRootPart.CFrame = targetPart.CFrame
                                        task.wait(0.15)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end)
    else
        if autoCoinConn then
            task.cancel(autoCoinConn)
            autoCoinConn = nil
        end
    end
end)


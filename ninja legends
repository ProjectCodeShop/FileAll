local getNinjaEvent = function()
    if localPlayer:FindFirstChild("ninjaEvent") then return localPlayer.ninjaEvent end
    if localPlayer.Character and localPlayer.Character:FindFirstChild("ninjaEvent") then return localPlayer.Character.ninjaEvent end
    if ReplicatedStorage:FindFirstChild("ninjaEvent") then return ReplicatedStorage.ninjaEvent end
    return nil
end

-- 1. Auto Swing Katana
local autoFarmConn = nil
local swingArgs = {[1] = "swingKatana", n = 1}
local fb1 = createBox(farmPage, 0, 0, 185, 130, "Auto Farm Katana")
addToggle(fb1, "Fast Swing Katana", 28, function(enabled)
    if enabled then
        autoFarmConn = RunService.RenderStepped:Connect(function()
            local ev = getNinjaEvent()
            if ev then ev:FireServer(unpack(swingArgs, 1, swingArgs.n or #swingArgs)) end
        end)
    else
        if autoFarmConn then autoFarmConn:Disconnect() autoFarmConn = nil end
    end
end)

-- 2. ระบบ Teleport Player To Hoops
local autoHoopConn = nil
local fb2 = createBox(farmPage, 195, 0, 185, 130, "Auto Farm Items")
addToggle(fb2, "Teleport Player To Hoops", 28, function(enabled)
    if enabled then
        autoHoopConn = task.spawn(function()
            while task.wait(0.1) do
                local char = localPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    for _, obj in ipairs(Workspace:GetDescendants()) do
                        if obj.Name == "Hoop" then
                            local targetPart = nil
                            if obj:IsA("BasePart") then
                                targetPart = obj
                            elseif obj:IsA("Model") then
                                targetPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                            end
                            
                            if targetPart and char:FindFirstChild("HumanoidRootPart") then
                                char.HumanoidRootPart.CFrame = targetPart.CFrame
                                task.wait(0.2)
                            end
                        end
                    end
                end
            end
        end)
    else
        if autoHoopConn then
            task.cancel(autoHoopConn)
            autoHoopConn = nil
        end
    end
end)

-- 3. ระบบ Teleport Collect Coins (ดึงข้อมูลจาก spawnedCoins -> Duel Arena & Valley)

local function createESP(player)
    if player == LocalPlayer then return end

    local box = Drawing.new("Square")
    box.Visible = false
    box.Color = Color3.fromRGB(255, 50, 50)
    box.Thickness = 1.5
    box.Filled = false

    local tracer = Drawing.new("Line")
    tracer.Visible = false
    tracer.Color = Color3.fromRGB(255, 50, 50)
    tracer.Thickness = 1

    local healthBar = Drawing.new("Square")
    healthBar.Visible = false
    healthBar.Color = Color3.fromRGB(0, 255, 0)
    healthBar.Thickness = 1
    healthBar.Filled = true

    local healthBarBg = Drawing.new("Square")
    healthBarBg.Visible = false
    healthBarBg.Color = Color3.fromRGB(0, 0, 0)
    healthBarBg.Thickness = 1
    healthBarBg.Filled = true

    local nameTag = Drawing.new("Text")
    nameTag.Visible = false
    nameTag.Center = true
    nameTag.Outline = true
    nameTag.Font = 2
    nameTag.Size = 13
    nameTag.Color = Color3.fromRGB(255, 255, 255)

    local function setupHighlight(char)
        if not char:FindFirstChild("MagicAlay_Highlight") then
            local hl = Instance.new("Highlight")
            hl.Name = "MagicAlay_Highlight"
            hl.Adornee = char
            hl.FillColor = Color3.fromRGB(255, 40, 40)
            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
            hl.FillTransparency = 0.4
            hl.OutlineTransparency = 0
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = char
        end
    end

    if player.Character then
        setupHighlight(player.Character)
    end
    player.CharacterAdded:Connect(setupHighlight)

    RunService.RenderStepped:Connect(function()
        if not ESP_Enabled or not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") or not player.Character:FindFirstChildOfClass("Humanoid") then
            box.Visible = false
            tracer.Visible = false
            healthBar.Visible = false
            healthBarBg.Visible = false
            nameTag.Visible = false
            return
        end

        local char = player.Character
        local rootPart = char.HumanoidRootPart
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        
        if humanoid and humanoid.Health <= 0 then
            box.Visible = false
            tracer.Visible = false
            healthBar.Visible = false
            healthBarBg.Visible = false
            nameTag.Visible = false
            return
        end

        local pos, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
        if onScreen then
            local head = char:FindFirstChild("Head")
            local topPos = head and Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or pos
            local bottomPos = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3, 0))
            
            local height = math.abs(topPos.Y - bottomPos.Y)
            local width = height / 2

            if BoxESP_Enabled then
                box.Size = Vector2.new(width, height)
                box.Position = Vector2.new(pos.X - width / 2, topPos.Y)
                box.Visible = true
                box.Color = isEnemy(player) and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(50, 255, 50)
            else
                box.Visible = false
            end

            if Tracers_Enabled then
                tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                tracer.To = Vector2.new(pos.X, bottomPos.Y)
                tracer.Visible = true
                tracer.Color = box.Color
            else
                tracer.Visible = false
            end

            if HealthBar_Enabled and humanoid then
                local healthPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                local barHeight = height * healthPercent
                
                healthBarBg.Size = Vector2.new(3, height)
                healthBarBg.Position = Vector2.new(pos.X - width / 2 - 6, topPos.Y)
                healthBarBg.Visible = true

                healthBar.Size = Vector2.new(1.5, barHeight)
                healthBar.Position = Vector2.new(pos.X - width / 2 - 5, topPos.Y + (height - barHeight))
                healthBar.Color = Color3.fromRGB(255 - (healthPercent * 255), healthPercent * 255, 0)
                healthBar.Visible = true
            else
                healthBar.Visible = false
                healthBarBg.Visible = false
            end

            if NameESP_Enabled then
                local dist = math.floor((rootPart.Position - Camera.CFrame.Position).Magnitude)
                nameTag.Text = player.Name .. " [" .. dist .. "m]"
                nameTag.Position = Vector2.new(pos.X, topPos.Y - 18)
                nameTag.Visible = true
            else
                nameTag.Visible = false
            end
        else
            box.Visible = false
            tracer.Visible = false
            healthBar.Visible = false
            healthBarBg.Visible = false
            nameTag.Visible = false
        end
    end)
end


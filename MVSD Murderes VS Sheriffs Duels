local function getBestTarget()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil, nil end

    local myPos = root.Position + Vector3.new(0, 1.5, 0)
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local bestPart = nil
    local bestChar = nil
    local shortestDist = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if isEnemy(player) then
            local targetChar = player.Character
            if targetChar then
                local hum = targetChar:FindFirstChildOfClass("Humanoid")
                local targetPart = getTargetPart(targetChar)

                if targetPart and hum and hum.Health > 0 then
                    local targetPos = targetPart.Position
                    local dist = (targetPos - myPos).Magnitude

                    if dist <= maxDistance then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPos)
                        if onScreen then
                            local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                            if screenDist <= FOVRadius then
                                if screenDist < shortestDist then
                                    shortestDist = screenDist
                                    bestPart = targetPart
                                    bestChar = targetChar
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return bestPart, bestChar
end

-- ฟังก์ชันยิง 1 ครั้ง ส่งรีโมท 1 ครั้งตรงเป้าหมายทันที
local function fireAtTarget()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        local myPos = root.Position + Vector3.new(0, 1.5, 0)
        local bestPart, bestChar = getBestTarget()
        
        if bestPart and bestChar then
            local targetRoot = bestChar:FindFirstChild("HumanoidRootPart") or bestPart
            local tPos = bestPart.Position
            local velocity = targetRoot.AssemblyLinearVelocity or targetRoot.Velocity or Vector3.zero
            
            local distance = (tPos - myPos).Magnitude
            local flightTime = distance / bulletSpeed
            local predictedPos = tPos + (velocity * flightTime)
            
            if math.abs(velocity.Y) > 2 then
                predictedPos = predictedPos + Vector3.new(0, 0.5 * workspace.Gravity * (flightTime ^ 2), 0)
            end
            
            pcall(function()
                ShootRemote:FireServer(myPos, predictedPos, bestPart, predictedPos)
            end)
        end
    end
end

task.spawn(function()
    while true do
        if AutoKill then
            local currentTime = tick()
            if currentTime - lastShoot >= fireRate then
                lastShoot = currentTime
                fireAtTarget()
            end
        end
        task.wait(0.005)
    end
end)


FloatStroke.Thickness = 1.2
FloatStroke.Transparency = 0.75

local floatDragging = false
local floatDragStart, floatStartPos
local dragThreshold = 5
local isClick = true

FloatBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        floatDragging = true
        isClick = true
        floatDragStart = input.Position
        floatStartPos = FloatBtn.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                floatDragging = false
            end
        end)
    end
end)

FloatBtn.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        if floatDragging then
            local delta = input.Position - floatDragStart
            if delta.Magnitude > dragThreshold then
                isClick = false
            end
            
            FloatBtn.Position = UDim2.new(
                floatStartPos.X.Scale, floatStartPos.X.Offset + delta.X,
                floatStartPos.Y.Scale, floatStartPos.Y.Offset + delta.Y
            )
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not floatDragging then
        if not isClick then
            local camera = Workspace.CurrentCamera
            local viewportSize = camera.ViewportSize
            local currentX = FloatBtn.AbsolutePosition.X
            local currentY = FloatBtn.AbsolutePosition.Y
            
            local targetX = 14
            if currentX > (viewportSize.X / 2) then
                targetX = viewportSize.X - FloatBtn.AbsoluteSize.X - 14
            end

            local targetY = math.clamp(currentY, 14, viewportSize.Y - FloatBtn.AbsoluteSize.Y - 14)

            local targetPos = UDim2.new(0, targetX, 0, targetY)
            local tweenInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
            TweenService:Create(FloatBtn, tweenInfo, {Position = targetPos}):Play()
        end
    end
end)

FloatBtn.MouseButton1Click:Connect(function()
    if isClick then
        ToggleHub()
    end
end)

local function CreateiOSToggle(parentPage, titleText, defaultState, callback)
    local Card = Instance.new("TextButton")
    Card.Name = titleText .. "Card"
    Card.Size = UDim2.new(0.96, 0, 0, 42)
    Card.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Card.BackgroundTransparency = 0.93
    Card.Text = ""
    Card.AutoButtonColor = false
    Card.Parent = parentPage
    Instance.new("UICorner", Card).CornerRadius = UDim.new(0, 14)

    local Stroke = Instance.new("UIStroke", Card)
    Stroke.Color = Color3.fromRGB(255, 255, 255)
    Stroke.Thickness = 1
    Stroke.Transparency = 0.88

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, -60, 1, 0)
    Label.Position = UDim2.new(0, 14, 0, 0)
    Label.Text = titleText
    Label.Font = Enum.Font.GothamMedium
    Label.TextSize = 11
    Label.TextColor3 = Color3.fromRGB(235, 235, 245)
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.BackgroundTransparency = 1
    Label.Parent = Card

    local TogglePill = Instance.new("Frame")
    TogglePill.Size = UDim2.new(0, 38, 0, 22)
    TogglePill.Position = UDim2.new(1, -50, 0.5, -11)
    TogglePill.BackgroundColor3 = defaultState and Color3.fromRGB(52, 199, 89) or Color3.fromRGB(120, 120, 130)
    TogglePill.BackgroundTransparency = defaultState and 0 or 0.5
    TogglePill.Parent = Card
    Instance.new("UICorner", TogglePill).CornerRadius = UDim.new(1, 0)

    local ToggleCircle = Instance.new("Frame")
    ToggleCircle.Size = UDim2.new(0, 18, 0, 18)
    ToggleCircle.Position = defaultState and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
    ToggleCircle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    ToggleCircle.Parent = TogglePill
    Instance.new("UICorner", ToggleCircle).CornerRadius = UDim.new(1, 0)

    local state = defaultState

    Card.MouseButton1Click:Connect(function()
        state = not state
        local targetCirclePos = state and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
        local targetPillColor = state and Color3.fromRGB(52, 199, 89) or Color3.fromRGB(120, 120, 130)
        local targetPillTrans = state and 0 or 0.5

        TweenService:Create(ToggleCircle, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = targetCirclePos}):Play()
        TweenService:Create(TogglePill, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {BackgroundColor3 = targetPillColor, BackgroundTransparency = targetPillTrans}):Play()

        callback(state, Card)
    end)

    return Card
end


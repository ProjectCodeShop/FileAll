-- ==========================================
-- ฟังก์ชัน Auto Win (สลับวาร์ปรัวๆ ระหว่าง ObbyTower และ World1)
-- ==========================================
local autoWinEnabled = false
task.spawn(function()
    while true do
        if autoWinEnabled then
            pcall(function()
                local rootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if rootPart then
                    local obbyObj = Workspace:FindFirstChild("ObbyTower", true)
                    if obbyObj then
                        if obbyObj:IsA("Model") then
                            local primaryPart = obbyObj.PrimaryPart or obbyObj:FindFirstChildWhichIsA("BasePart")
                            if primaryPart then rootPart.CFrame = primaryPart.CFrame + Vector3.new(0, 3, 0) end
                        elseif obbyObj:IsA("BasePart") then
                            rootPart.CFrame = obbyObj.CFrame + Vector3.new(0, 3, 0)
                        end
                    end
                end
            end)
            task.wait(0.05)
            
            if not autoWinEnabled then break end
            
            pcall(function()
                local rootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if rootPart then
                    local world1Obj = Workspace:FindFirstChild("World1", true)
                    if world1Obj then
                        if world1Obj:IsA("Model") then
                            local primaryPart = world1Obj.PrimaryPart or world1Obj:FindFirstChildWhichIsA("BasePart")
                            if primaryPart then rootPart.CFrame = primaryPart.CFrame + Vector3.new(0, 3, 0) end
                        elseif world1Obj:IsA("BasePart") then
                            rootPart.CFrame = world1Obj.CFrame + Vector3.new(0, 3, 0)
                        end
                    end
                end
            end)
            task.wait(0.05)
        else
            task.wait(0.5)
        end
    end
end)

-- ==========================================
-- ฟังก์ชัน Auto World Teleport (World1 - World19 วนลูป)
-- ==========================================
local autoWorldTeleportEnabled = false
task.spawn(function()
    while true do
        if autoWorldTeleportEnabled then
            for i = 1, 19 do
                if not autoWorldTeleportEnabled then break end
                pcall(function()
                    local worldName = "World" .. i
                    local targetObj = Workspace:FindFirstChild(worldName, true)

                    if targetObj then
                        local rootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if rootPart then
                            if targetObj:IsA("Model") then
                                local primaryPart = targetObj.PrimaryPart or targetObj:FindFirstChild("HumanoidRootPart") or targetObj:FindFirstChildWhichIsA("BasePart")
                                if primaryPart then
                                    rootPart.CFrame = primaryPart.CFrame + Vector3.new(0, 3, 0)
                                end
                            elseif targetObj:IsA("BasePart") then
                                rootPart.CFrame = targetObj.CFrame + Vector3.new(0, 3, 0)
                            end
                        end
                    end
                end)
                task.wait(0.1)
            end
        else
            task.wait(0.5)
        end
    end
end)


local fpsOriginals
local function ApplyFpsBoost(on)
    pcall(function()
        if on then
            if not fpsOriginals then
                fpsOriginals = { Shadows = Lighting.GlobalShadows, Quality = settings().Rendering.QualityLevel }
            end
            Lighting.GlobalShadows = false
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
            for _, v in ipairs(Lighting:GetChildren()) do
                if v:IsA("BloomEffect") or v:IsA("SunRaysEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("BlurEffect") and v.Name ~= "UIBlurEffect" then
                    v.Enabled = false
                end
            end
        elseif fpsOriginals then
            Lighting.GlobalShadows = fpsOriginals.Shadows
            settings().Rendering.QualityLevel = fpsOriginals.Quality
            fpsOriginals = nil
        end
    end)
end


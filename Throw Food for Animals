local toggleFarm = Row(MainLeft, "Start Timed Hybrid Farm", "Auto switch between training and remote throwing")
RegisterText(toggleFarm:FindFirstChildWhichIsA("TextLabel"), "StartFarm")
MakeToggle(toggleFarm, false, function(on)
    hybridActive = on
    task.spawn(function()
        while hybridActive do
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root and not trainingPosition then trainingPosition = root.CFrame end

            -- 1. Training Phase
            local startTime = tick()
            while hybridActive and (tick() - startTime < trainDuration) do
                pcall(function()
                    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                    if remotes and remotes:FindFirstChild("Training_Start") then
                        remotes.Training_Start:InvokeServer(table.unpack({n = 0}, 1, 0))
                    end
                end)
                task.wait(0.2)
            end

            if not hybridActive then break end

            -- 2. Teleport to Throw Remote Spot
            if root and trainingPosition then root.CFrame = throwTargetPosition end

            local throwStartTime = tick()
            while hybridActive and (tick() - throwStartTime < throwDuration) do
                pcall(function()
                    local remotes = ReplicatedStorage:WaitForChild("Remotes")
                    local throwStart = remotes:WaitForChild("Throw_Start")
                    local throwResolve = remotes:WaitForChild("Throw_Resolve")
                    local analyticsFps = ReplicatedStorage:FindFirstChild("UserGenerated") 
                        and ReplicatedStorage.UserGenerated:FindFirstChild("Analytics") 
                        and ReplicatedStorage.UserGenerated.Analytics.ClientKit 
                        and ReplicatedStorage.UserGenerated.Analytics.ClientKit:FindFirstChild("Fps")

                    if analyticsFps then
                        analyticsFps:FireServer(table.unpack({ [1] = 6, [2] = 43.0550357000591, [3] = 4, n = 3 }, 1, 3))
                    end

                    throwStart:InvokeServer(table.unpack({n = 0}, 1, 0))
                    task.wait(0.12)
                    throwResolve:InvokeServer(table.unpack({ [1] = 0.21420293186691322, n = 1 }, 1, 1))
                end)
                task.wait(0.3)
            end

            if not hybridActive then break end

            -- 3. Teleport back to Training Spot
            if root and trainingPosition then root.CFrame = trainingPosition end
        end
    end)
end)


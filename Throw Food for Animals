local function SetOpen(state)
    if isOpen == state then return end
    isOpen = state
    PlaySound(SOUND_MENU)
    UpdateBlurState()
    local base = BaseScale()
    if state then
        MainFrame.Visible = true
        WindowScale.Scale = base * 0.86
        TweenService:Create(WindowScale, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = base }):Play()
        LayoutTabs(true)
    else
        local tw = TweenService:Create(WindowScale, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In), { Scale = base * 0.85 })
        tw:Play()
        tw.Completed:Connect(function() if not isOpen then MainFrame.Visible = false end end)
    end
end

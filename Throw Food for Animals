local function JoinDiscord()
    local opened = false
    if ORIG_REQUEST then
        pcall(function()
            local r = ORIG_REQUEST({
                Url = "http://127.0.0.1:6463/rpc?v=1", Method = "POST",
                Headers = { ["Content-Type"] = "application/json", Origin = "https://discord.com" },
                Body = HttpService:JSONEncode({ cmd = "INVITE_BROWSER", args = { code = "rejKjgnvx" }, nonce = HttpService:GenerateGUID(false) })
            })
            if r and (r.StatusCode or 0) < 300 then opened = true end
        end)
    end
    if not opened then CopyToClipboard("https://discord.gg/rejKjgnvx") end
    ShowiOSNotification("Discord", opened and "Opening Discord..." or "Link copied to clipboard")
end


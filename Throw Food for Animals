local function Row(parent, title, desc, opts)
    opts = opts or {}
    local h = opts.Height or (desc and 50 or 40)
    local r = New(opts.Click and "TextButton" or "Frame", { Size = U(1, 0, 0, h), BackgroundColor3 = opts.Color or ROW }, parent)
    if opts.Click then
        r.Text = ""
        r.AutoButtonColor = false
        PressEffect(r, 0.98)
    end
    Corner(r, 9)
    local pad = opts.RightPad or 64
    local t = Label(r, { Size = U(1, -pad, 0, 16), Position = U(0, 12, 0, desc and 8 or (h - 16) / 2), Text = title, Font = FB, TextSize = 12.5, TextTruncate = TRUNC })
    local d
    if desc then
        d = Label(r, {
            Size = U(1, -pad, 0, h - 28), Position = U(0, 12, 0, 26), Text = desc, TextSize = 10, TextColor3 = SUB,
            TextWrapped = opts.Wrap or false, TextYAlignment = Enum.TextYAlignment.Top,
            TextTruncate = opts.Wrap and Enum.TextTruncate.None or TRUNC
        })
    end
    if opts.Chevron then
        Label(r, { Size = U(0, 20, 1, 0), Position = U(1, -28, 0, 0), Text = "›", Font = FB, TextSize = 22, TextColor3 = ACC2, TextXAlignment = XC })
    end
    return r, t, d
end

local function MakeToggle(row, initial, onChange)
    local on = initial
    local track = New("TextButton", {
        Size = U(0, 46, 0, 24), Position = U(1, -58, 0.5, -12), BackgroundColor3 = RGB(12, 13, 30), Text = "", AutoButtonColor = false
    }, row)
    Corner(track, 12)
    local tStroke = Stroke(track, on and 0.1 or 0.5, 1.2, on and ACC or LINE)
    local knob = New("Frame", {
        Size = U(0, 18, 0, 18), Position = on and U(1, -21, 0.5, -9) or U(0, 3, 0.5, -9),
        BackgroundColor3 = on and ACC2 or RGB(150, 152, 168)
    }, track)
    Corner(knob, 9)
    local function apply(v)
        on = v
        TweenService:Create(knob, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Position = on and U(1, -21, 0.5, -9) or U(0, 3, 0.5, -9), BackgroundColor3 = on and ACC2 or RGB(150, 152, 168)
        }):Play()
        TweenService:Create(tStroke, TweenInfo.new(0.25), { Transparency = on and 0.1 or 0.5, Color = on and ACC or LINE }):Play()
    end
    track.MouseButton1Click:Connect(function()
        PlaySound(SOUND_CLICK)
        apply(not on)
        onChange(on)
    end)
    return apply
end

local function BuildAvatar(parent, size, color, name, userId, pos)
    local holder = New("Frame", { Size = U(0, size, 0, size), Position = pos, BackgroundColor3 = color, BackgroundTransparency = 0.7 }, parent)
    Corner(holder, size / 2)
    Stroke(holder, 0.2, 1.5, color)
    local initial = Label(holder, { Size = U(1, 0, 1, 0), Text = string.upper(string.sub(name, 1, 1)), Font = FB, TextSize = math.floor(size * 0.45), TextXAlignment = XC })
    if userId then
        task.spawn(function()
            pcall(function()
                local content, ok = Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
                if ok then
                    initial.Visible = false
                    local img = New("ImageLabel", { Size = U(1, 0, 1, 0), BackgroundTransparency = 1, Image = content }, holder)
                    Corner(img, size / 2)
                end
            end)
        end)
    end
    return holder
end

local function SubLabel(parent, text)
    local h = New("Frame", { Size = U(1, 0, 0, 18), BackgroundTransparency = 1 }, parent)
    local lbl = Label(h, { Size = U(0, 140, 1, 0), Position = U(0, 4, 0, 2), Text = text, Font = FB, TextSize = 9.5, TextColor3 = ACC2 })
    local line = New("Frame", { Size = U(1, -60, 0, 1), Position = U(0, 60, 0.5, 1), BackgroundColor3 = LINE, BackgroundTransparency = 0.35 }, h)
    New("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }) }, line)
    local function place()
        local w = lbl.TextBounds.X + 12
        line.Position = U(0, w, 0.5, 1)
        line.Size = U(1, -(w + 4), 0, 1)
    end
    place()
    lbl:GetPropertyChangedSignal("TextBounds"):Connect(place)
    return h, lbl
end

-- ==================== TAB SYSTEM ====================
local Tabs = {}
local currentTab
local INACTIVE_TXT = RGB(150, 157, 190)

local function LayoutTabs(animate)
    local i = 0
    for _, t in ipairs(Tabs) do
        if t.Button and t.Button.Visible then
            t.X = i * TAB_W
            i = i + 1
            if animate then
                t.Button.Position = U(0, t.X, 0, 8)
                TweenService:Create(t.Button, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = U(0, t.X, 0, 0) }):Play()
            else
                t.Button.Position = U(0, t.X, 0, 0)
            end
        end
    end
end

local function CreateTab(tabNameKey, iconId, hidden)
    local tab = { NameKey = tabNameKey, Hidden = hidden, X = 0 }
    if not hidden then
        local btn = New("TextButton", { Size = U(0, TAB_W, 0, NAV_H), BackgroundTransparency = 1, Text = "", AutoButtonColor = false }, NavBar)
        local icon = New("ImageLabel", { Size = U(0, 16, 0, 16), Position = U(0, 6, 0.5, -8), BackgroundTransparency = 1, ImageColor3 = INACTIVE_TXT }, btn)
        ApplyImageAsset(icon, iconId or RAW_ASSET_ID)
        local lbl = Label(btn, { Size = U(1, -26, 1, 0), Position = U(0, 26, 0, 0), Text = LangData[currentLang][tabNameKey] or tabNameKey, Font = FB, TextSize = 11.5, TextColor3 = INACTIVE_TXT })
        tab.Button, tab.Icon, tab.Label = btn, icon, lbl
        PressEffect(btn, 0.92)
    end

    local area = New("CanvasGroup", {
        Size = U(1, -28, 1, -(CONTENT_Y + 14)), Position = U(0, 14, 0, CONTENT_Y), BackgroundTransparency = 1, Visible = false, GroupTransparency = 1
    }, Content)
    tab.Area, tab.Body = area, area

    tab.Select = function()
        PlaySound(SOUND_MENU)
        for _, t in ipairs(Tabs) do
            if t ~= tab then
                t.Area.Visible = false
                if t.Button then
                    TweenService:Create(t.Icon, TweenInfo.new(0.2), { ImageColor3 = INACTIVE_TXT }):Play()
                    TweenService:Create(t.Label, TweenInfo.new(0.2), { TextColor3 = INACTIVE_TXT }):Play()
                end
            end
        end
        currentTab = tab
        if tab.Button then
            local ux = tab.X + (TAB_W - 36) / 2
            if not Underline.Visible then Underline.Position = U(0, ux, 1, -3) end
            Underline.Visible = true
            TweenService:Create(Underline, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Position = U(0, ux, 1, -3) }):Play()
            TweenService:Create(tab.Icon, TweenInfo.new(0.2), { ImageColor3 = WHITE }):Play()
            TweenService:Create(tab.Label, TweenInfo.new(0.2), { TextColor3 = WHITE }):Play()
        else
            Underline.Visible = false
        end
        area.Visible = true
        area.GroupTransparency = 1
        area.Position = U(0, 14, 0, CONTENT_Y + 14)
        TweenService:Create(area, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Position = U(0, 14, 0, CONTENT_Y), GroupTransparency = 0 }):Play()
    end
    if tab.Button then tab.Button.MouseButton1Click:Connect(tab.Select) end
    table.insert(Tabs, tab)
    return tab
end


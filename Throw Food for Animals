-- ==================== OPEN / CLOSE ====================
SetOpen = function(state)
    if isOpen == state then return end
    isOpen = state
    PlaySound(SOUND_MENU)
    UpdateBlurState()
    local base = BaseScale()
    if state then
        MainFrame.Visible = true
        WindowScale.Scale = base * 0.86
        TweenService:Create(WindowScale, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = base }):Play()
        LayoutTabs(true)
    else
        local tw = TweenService:Create(WindowScale, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In), { Scale = base * 0.85 })
        tw:Play()
        tw.Completed:Connect(function()
            if not isOpen then MainFrame.Visible = false end
        end)
    end
end
MinBtn.MouseButton1Click:Connect(function() SetOpen(false) end)
Track(UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe or customConfig.Keybind == false then return end
    if input.KeyCode == Enum.KeyCode.RightShift then SetOpen(not isOpen) end
end))

local function DestroyHub()
    SetOpen(false)
    task.delay(0.4, function()
        if protect_env.MagicAlayCleanup then protect_env.MagicAlayCleanup() end
    end)
end
CloseBtn.MouseButton1Click:Connect(DestroyHub)

-- ลากหน้าต่างที่แถบหัว
do
    local dragging, dragStart, startPos
    HeaderBar.InputBegan:Connect(function(input)
        if IsPress(input) then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    OnInputChanged(function(input)
        if dragging and IsMove(input) then
            local d = input.Position - dragStart
            MainFrame.Position = U(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
end


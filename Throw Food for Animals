local function NewScroll(parent, size, pos, grid)
    local s = New("ScrollingFrame", {
        Size = size, Position = pos, BackgroundTransparency = 1, ScrollBarThickness = 3, ScrollBarImageColor3 = ACC2,
        ScrollBarImageTransparency = 0.3, CanvasSize = U(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y
    }, parent)
    if grid then
        New("UIGridLayout", { CellSize = U(0.5, -9, 0, 54), CellPadding = U(0, 8, 0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, s)
    else
        New("UIListLayout", { Padding = UDim.new(0, 7), SortOrder = Enum.SortOrder.LayoutOrder }, s)
    end
    New("UIPadding", { PaddingBottom = UDim.new(0, 6), PaddingRight = UDim.new(0, 6) }, s)
    return s
end


-- ==================== HELPERS ====================
local function New(class, props, parent)
    local o = Instance.new(class)
    if o:IsA("GuiObject") then o.BorderSizePixel = 0 end
    for k, v in pairs(props or {}) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end
local function Corner(o, r) return New("UICorner", { CornerRadius = UDim.new(0, r) }, o) end
local function Stroke(o, t, th, c)
    return New("UIStroke", { Color = c or WHITE, Transparency = t or 0.88, Thickness = th or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o)
end
local function Label(parent, props)
    props.BackgroundTransparency = 1
    props.Font = props.Font or FM
    props.TextColor3 = props.TextColor3 or WHITE
    props.TextXAlignment = props.TextXAlignment or XL
    props.TextSize = props.TextSize or 12
    return New("TextLabel", props, parent)
end
local function IsPress(i) return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch end
local function IsMove(i) return i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch end
local function PressEffect(btn, amount)
    local sc = btn:FindFirstChildOfClass("UIScale") or New("UIScale", {}, btn)
    local hovering, pressing = false, false
    local function go(target, t, style, dir)
        TweenService:Create(sc, TweenInfo.new(t, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out), { Scale = target }):Play()
    end
    btn.MouseEnter:Connect(function()
        hovering = true
        if not pressing then go(1.025, 0.18) end
    end)
    btn.MouseLeave:Connect(function()
        hovering = false
        if not pressing then go(1, 0.22) end
    end)
    btn.InputBegan:Connect(function(i)
        if IsPress(i) then
            pressing = true
            go(amount or 0.96, 0.1)
        end
    end)
    btn.InputEnded:Connect(function(i)
        if IsPress(i) then
            pressing = false
            go(hovering and 1.025 or 1, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        end
    end)
end


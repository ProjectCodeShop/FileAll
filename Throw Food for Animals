local function JoinDiscord()
    local opened = false
    if ORIG_REQUEST then
        pcall(function()
            local r = ORIG_REQUEST({
                Url = "http://127.0.0.1:6463/rpc?v=1", Method = "POST",
                Headers = { ["Content-Type"] = "application/json", Origin = "https://discord.com" },
                Body = HttpService:JSONEncode({ cmd = "INVITE_BROWSER", args = { code = DISCORD_CODE }, nonce = HttpService:GenerateGUID(false) })
            })
            if r and (r.StatusCode or 0) < 300 then opened = true end
        end)
    end
    if not opened then CopyToClipboard(SUPPORT_LINK) end
    ShowiOSNotification("Discord", opened and "Opening Discord..." or "Link copied, paste it in your browser")
end


        pcall(function()
            local damageEvent = getACSCombatEvent()
            local character = LocalPlayer.Character
            if damageEvent and character and character:FindFirstChild("HumanoidRootPart") then
                local myRootPart = character.HumanoidRootPart
                local botsFolder = Workspace:FindFirstChild("Bots") or Workspace:FindFirstChild("Zombies") or Workspace:FindFirstChild("EventEnemies")
                if botsFolder then
                    for _, zombie in ipairs(botsFolder:GetChildren()) do
                        local humanoid = zombie:FindFirstChildOfClass("Humanoid")
                        local targetPart = zombie:FindFirstChild("Head") or zombie:FindFirstChild("HumanoidRootPart")
                        if humanoid and humanoid.Health > 0 and targetPart then
                            local args = {
                                [1] = {
                                    filterDescendants = {
                                        [1] = character,
                                        [2] = Workspace:FindFirstChild("Camera") and Workspace.Camera:FindFirstChild("Viewmodel") or Workspace
                                    },
                                    origin = myRootPart.Position,
                                    shellMaxDist = 9999,
                                    shellName = "DefaultMelee",
                                    shellSpeed = 500,
                                    shellType = "Melee",
                                    weaponName = "Knife"
                                },
                                [2] = humanoid,
                                [3] = 999999,
                                [4] = 1,
                                [5] = targetPart,
                                n = 5
                            }
                            damageEvent:InvokeServer(table.unpack(args, 1, 5))
                        end
                    end
                end
            end
        end)
    end
end)


local function getACSCombatEvent()
    local ACS_Engine = ReplicatedStorage:FindFirstChild("ACS_Engine")
    if ACS_Engine then
        local events = ACS_Engine:FindFirstChild("Events")
        if events then
            return events:FindFirstChild("Damage")
        end
    end
    return nil
end


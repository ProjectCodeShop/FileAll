-- ==========================================
-- 4. ระบบ AI ประชิดตัว + ระบบป้องกันทะลุกำแพง (Anti-Wall / Escape) + Anti-Kick / Anti-Crash (กันเตะเชิฟเวอร์)
-- ==========================================
RunService.RenderStepped:Connect(function(deltaTime)
    if _G.MagicAlayMiniFarm.Active then
        pcall(function()
            local character = player.Character
            if not character or not character:FindFirstChild("HumanoidRootPart") then return end
            local hrp = character.HumanoidRootPart
            local hum = character:FindFirstChildOfClass("Humanoid")

            if not groundSpot or not character:IsDescendantOf(workspace) then
                groundSpot = Vector3.new(hrp.Position.X, hrp.Position.Y, hrp.Position.Z)
                currentTarget = nil
                if hum then hum.PlatformStand = false end
                return
            end

            if currentTarget and currentTarget:FindFirstChild("HumanoidRootPart") then
                local tHrp = currentTarget.HumanoidRootPart
                local rayParams = RaycastParams.new()
                rayParams.FilterType = Enum.RaycastFilterType.Exclude
                rayParams.FilterDescendantsInstances = {character, currentTarget}
                rayParams.IgnoreWater = true

                local rayResult = workspace:Raycast(tHrp.Position, (hrp.Position - tHrp.Position), rayParams)
                if rayResult then
                    local escapePos = tHrp.Position + (tHrp.CFrame.LookVector * 3.5) + Vector3.new(0, 2, 0)
                    hrp.CFrame = CFrame.new(escapePos, tHrp.Position)
                    return
                end
            end

            if not currentTarget or not currentTarget.Parent or not currentTarget:FindFirstChild("Humanoid") or currentTarget.Humanoid.Health <= 0 then
                local shortestDist = math.huge
                currentTarget = nil
                
                for _, obj in pairs(workspace:GetDescendants()) do
                    local data = getEnemyData(obj)
                    if data then
                        local distToSpot = (data.HRP.Position - groundSpot).Magnitude
                        if distToSpot <= maxScanDist then
                            if distToSpot < shortestDist then
                                shortestDist = distToSpot
                                currentTarget = data.Model
                            end
                        end
                    end
                end
            end

            if not currentTarget then
                if hum then hum.PlatformStand = false end
                groundSpot = Vector3.new(hrp.Position.X, hrp.Position.Y, hrp.Position.Z)
                return
            end

            if hum then hum.PlatformStand = true end

            local nearestEnemyPos = nil
            local minEnemyDist = math.huge
            for _, obj in pairs(workspace:GetDescendants()) do
                local data = getEnemyData(obj)
                if data then
                    local dist = (data.HRP.Position - hrp.Position).Magnitude
                    if dist < 10 and dist < minEnemyDist then
                        minEnemyDist = dist
                        nearestEnemyPos = data.HRP.Position
                    end
                end
            end

            if currentTarget and currentTarget:FindFirstChild("HumanoidRootPart") then
                local tHrp = currentTarget.HumanoidRootPart
                local tHum = currentTarget:FindFirstChildOfClass("Humanoid")
                local targetGroundY = tHrp.Position.Y + 0.5
                
                local enemyVel = tHrp.AssemblyLinearVelocity or Vector3.new(0, 0, 0)
                local predictedPos = tHrp.Position + (enemyVel * 0.12)
                
                dodgeTimer = dodgeTimer + (deltaTime * 1.5)
                if dodgeTimer > 1.8 then
                    dodgeTimer = 0
                    dodgeDirection = dodgeDirection * -1
                end

                local isBoss = tHum and (tHum.MaxHealth > 1000 or currentTarget.Name:lower():find("boss"))
                local enemyRight = tHrp.CFrame.RightVector
                local enemyLook = tHrp.CFrame.LookVector
                
                local targetCFrame

                if nearestEnemyPos then
                    local escapeDir = (hrp.Position - nearestEnemyPos).Unit
                    local escapePos = hrp.Position + (escapeDir * 12) + (enemyRight * (5 * dodgeDirection))
                    local finalPos = Vector3.new(escapePos.X, targetGroundY, escapePos.Z)
                    targetCFrame = CFrame.new(finalPos, predictedPos)
                else
                    local isDudging = (dodgeTimer > 1.0)
                    
                    if isDudging then
                        local orbitDist = isBoss and 16 or 9
                        local orbitVector = (-enemyLook * orbitDist) + (enemyRight * (6 * dodgeDirection))
                        local orbitPos = Vector3.new(predictedPos.X, targetGroundY, predictedPos.Z) + orbitVector
                        targetCFrame = CFrame.new(orbitPos, predictedPos)
                    else
                        local attackDist = isBoss and 8.0 or 4.5
                        local attackVector = (-enemyLook * attackDist) + (enemyRight * (1.2 * dodgeDirection))
                        local attackPos = Vector3.new(predictedPos.X, targetGroundY, predictedPos.Z) + attackVector
                        targetCFrame = CFrame.new(attackPos, predictedPos)
                    end
                end

                local smoothness = math.clamp(deltaTime * 12, 0.1, 0.25)
                hrp.CFrame = hrp.CFrame:Lerp(targetCFrame, smoothness)
            else
                local idleAngle = tick() * 1.5
                local idleOffset = Vector3.new(math.cos(idleAngle) * 4, 0, math.sin(idleAngle) * 4)
                local stayPos = Vector3.new(groundSpot.X, groundSpot.Y, groundSpot.Z) + idleOffset
                local idleCFrame = CFrame.new(stayPos, groundSpot)
                
                hrp.CFrame = hrp.CFrame:Lerp(idleCFrame, 0.1)
            end

            if _G.MagicAlaySettings.AntiFling then
                hrp.Velocity = Vector3.new(0, 0, 0)
                hrp.RotVelocity = Vector3.new(0, 0, 0)
            end
        end)
    else
        pcall(function()
            local character = player.Character
            if character then
                local hum = character:FindFirstChildOfClass("Humanoid")
                if hum then hum.PlatformStand = false end
            end
        end)
    end
end)


local function getEnemyData(model)
    if not model:IsA("Model") then return nil end
    local hum = model:FindFirstChildOfClass("Humanoid")
    local hrp = model:FindFirstChild("HumanoidRootPart")
    
    if not hum or not hrp or hum.Health <= 0 then return nil end
    
    local name = model.Name:lower()
    if name:find("dummy") or name:find("npc") or name:find("trainer") or name:find("test") then
        return nil
    end
    
    if Players:GetPlayerFromCharacter(model) then
        return nil
    end

    local isBoss = hum.MaxHealth > 1000 or name:find("boss") or name:find("king") or name:find("leader") or name:find("dragon")
    
    return {
        Model = model,
        HRP = hrp,
        Humanoid = hum,
        IsBoss = isBoss
    }
end


local function autoTriggerButton(btn)
    if not btn then return false end
    local triggered = false
    pcall(function()
        for _, conn in pairs(getconnections(btn.MouseButton1Click)) do
            conn:Fire()
            triggered = true
        end
        for _, conn in pairs(getconnections(btn.MouseButton1Down)) do
            conn:Fire()
            triggered = true
        end
        for _, conn in pairs(getconnections(btn.Activated)) do
            conn:Fire()
            triggered = true
        end
    end)
    return triggered
end

task.spawn(function()
    while true do
        task.wait(0.5)
        pcall(function()
            if not _G.MagicAlayMiniChoice or not _G.MagicAlayMiniChoice.Active then return end
            local playerGui = player:FindFirstChild("PlayerGui")
            if not playerGui then return end
            
            local now = tick()
            if now - lastChoiceClick < 0.8 then return end

            for _, gui in pairs(playerGui:GetDescendants()) do
                if gui.Name:lower():find("choice") or gui.Name:lower():find("perk") or gui.Name:lower():find("ability") then
                    if gui:IsA("GuiObject") and (gui.Visible or gui.AbsoluteSize.X > 0) then
                        local availableBtns = {}
                        for _, obj in pairs(gui:GetDescendants()) do
                            if (obj:IsA("TextButton") or obj:IsA("ImageButton")) and (obj.Visible or obj.AbsoluteSize.X > 0) then
                                table.insert(availableBtns, obj)
                            end
                        end

                        if #availableBtns > 0 then
                            local randomBtn = availableBtns[math.random(1, #availableBtns)]
                            if autoTriggerButton(randomBtn) then
                                lastChoiceClick = tick()
                                break
                            end
                        end
                    end
                end
            end
        end)
    end
end)



-- Background Loop: Smart High-Health Burst Spam with ALL Inventory Weapons Multi-Fire
task.spawn(function()
    while task.wait(0.1) do
        if autoKillZombiesState then
            pcall(function()
                local weapons = getAllWeapons()
                local remote = getRemoteEvent()
                local activeZombies = workspace:FindFirstChild("ActiveZombies")
                local char = workspace:FindFirstChild(LocalPlayer.Name) or LocalPlayer.Character
                
                if activeZombies and remote then
                    for _, zombie in ipairs(activeZombies:GetChildren()) do
                        local hitbox = zombie:FindFirstChild("BodyHitbox") or zombie:FindFirstChild("HumanoidRootPart") or zombie:FindFirstChild("Head")
                        local humanoid = zombie:FindFirstChildOfClass("Humanoid")
                        
                        if hitbox and humanoid and humanoid.Health > 0 then
                            local maxHp = humanoid.MaxHealth or 100
                            local currentHp = humanoid.Health
                            
                            -- กำหนดจำนวนครั้งในการสแปมยิงตามเลือดซอมบี้
                            local spamCount = 1
                            if currentHp > 250 or maxHp > 250 then
                                spamCount = 4 -- เลือดเยอะสแปม 4 ชุด
                            else
                                spamCount = 2
                            end
                            
                            -- ยิงด้วยอาวุธทุกชิ้นในตัวพร้อมกันแบบ Multi-Fire
                            for _, weaponName in ipairs(weapons) do
                                local exitPart = char and char:FindFirstChild(weaponName) and char[weaponName]:FindFirstChild("Exit")
                                
                                for i = 1, spamCount do
                                    local targetPos = hitbox.Position
                                    local originPos = exitPart and exitPart.Position or (char and char:FindFirstChild("Head") and char.Head.Position) or targetPos
                                    
                                    local args = {
                                        [1] = weaponName,
                                        [2] = {
                                            [1] = {
                                                [1] = hitbox,
                                                [2] = targetPos,
                                                [3] = Vector3.new(0, 1, 0)
                                            }
                                        },
                                        [3] = {
                                            [1] = {
                                                [1] = weaponName,
                                                [2] = originPos,
                                                [3] = targetPos,
                                                [4] = targetPos,
                                                [5] = true,
                                                [6] = hitbox,
                                                [7] = false,
                                                [8] = false,
                                                [9] = "Default",
                                                [10] = exitPart
                                            }
                                        },
                                        n = 3
                                    }
                                    
                                    pcall(function()
                                        remote:FireServer(table.unpack(args, 1, 3))
                                    end)
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)


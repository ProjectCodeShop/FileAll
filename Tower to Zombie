-- ดึง RemoteEvent สำหรับยิง
local function getRemoteEvent()
    local events = ReplicatedStorage:FindFirstChild("Events")
    if events then
        local actions = events:FindFirstChild("Actions")
        if actions then
            return actions:FindFirstChild("Fire")
        end
    end
    return nil
end

-- ดึงชื่ออาวุธทั้งหมดในตัวและใน Backpack เพื่อเอามาใช้งานพร้อมกัน
local function getAllWeapons()
    local weapons = {}
    local char = workspace:FindFirstChild(LocalPlayer.Name) or LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    
    if char then
        for _, item in ipairs(char:GetChildren()) do
            if item:IsA("Tool") or (item:IsA("Model") and item:FindFirstChild("Exit")) then
                table.insert(weapons, item.Name)
            end
        end
    end
    
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                table.insert(weapons, item.Name)
            end
        end
    end
    
    if #weapons == 0 then
        table.insert(weapons, "M1911")
    end
    return weapons
end

